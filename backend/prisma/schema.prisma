generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum RevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  USER_DISABLED
  ROLE_CHANGED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  /// Always stored lowercased
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          Role           @default(USER)
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  // Supports the admin user listing: ORDER BY created_at DESC, filtered by
  // role/is_active. The `search` filter is an unanchored ILIKE and needs a
  // trigram (pg_trgm) index to be served by an index -- not added here because
  // it requires CREATE EXTENSION.
  @@index([createdAt])
  @@index([role, isActive])
  @@map("users")
}

/// Opaque refresh tokens (only the SHA-256 hash is stored). Every refresh
/// rotates the token; all tokens from one login share a `familyId`, so a
/// replayed token can revoke the whole family.
model RefreshToken {
  id            String        @id @default(uuid()) @db.Uuid
  tokenHash     String        @unique @map("token_hash")
  familyId      String        @map("family_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime      @map("expires_at")
  revokedAt     DateTime?     @map("revoked_at")
  revokedReason RevokeReason? @map("revoked_reason")
  replacedById  String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy    RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces      RefreshToken? @relation("Rotation")
  userAgent     String?       @map("user_agent")
  ip            String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
