        <mxCell id="seq6-37" value="the draft in edit mode;&lt;br&gt;Save off: “1 widget&lt;br&gt;needs attention”" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="498" y="1002" as="sourcePoint" /><mxPoint x="64" y="1002" as="targetPoint" /></mxGeometry></mxCell>
