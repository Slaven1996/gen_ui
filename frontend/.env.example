# Base URL the SPA uses for API calls. Keep it relative (/api) so the app is
# same-origin in dev (Vite proxy) and in production (reverse proxy).
VITE_API_BASE_URL=/api

# Dev-server only: where the Vite proxy forwards /api. No VITE_ prefix, so it
# is read by vite.config.ts and never exposed to client code.
DEV_API_TARGET=http://localhost:3000

# Dev-server only: show the TanStack Router / Query devtools.
VITE_DEVTOOLS=false
