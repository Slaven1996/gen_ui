{
  "name": "@gen-ui/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and types shared by the backend and frontend (DTOs + Generative UI tool contracts).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "ai": "catalog:"
  },
  "devDependencies": {
    "ai": "catalog:",
    "typescript": "catalog:"
  }
}
