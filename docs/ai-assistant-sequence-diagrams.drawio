        <mxCell id="seq8-52" value="204 · the list refetches;&lt;br&gt;the open chat → a new chat" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="513" y="1364" as="sourcePoint" /><mxPoint x="273" y="1364" as="targetPoint" /></mxGeometry></mxCell>
