  <diagram id="ai-assistant-seq-7" name="7 New chat and title">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="1474" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="seq7-1" value="7 · A new chat and its title" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="600" height="32" as="geometry" /></mxCell>
        <mxCell id="seq7-2" value="A new chat exists only in the browser until its first message; the server creates its row then (start), titled with the question.&lt;br&gt;While the first answer streams, Claude Haiku writes a short title, and onEnd saves it unless the user renamed the chat meanwhile.&lt;br&gt;Code: frontend/src/features/assistant/store/chat-store.ts (openDraft, turnFetch, onFinish), components/chat-nav.tsx&lt;br&gt;backend/src/features/ai/ai.service.ts (writeTitle, onEnd), conversation-title.ts, conversations.service.ts (start, finish, retitle)&lt;br&gt;&lt;b&gt;Notation:&lt;/b&gt; solid line, filled head = call · open head = asynchronous or streamed message (SSE) · dashed = return · narrow bars = activation&lt;br&gt;&lt;b&gt;Colours:&lt;/b&gt; blue = browser (React) · green = API (NestJS) · orange = Claude (Anthropic API) · grey = PostgreSQL" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fdfdfd;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="910" height="98" as="geometry" /></mxCell>
        <mxCell id="seq7-3" value="User" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=34;labelBackgroundColor=#ffffff;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=32;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="40" height="1250" as="geometry" /></mxCell>
        <mxCell id="seq7-4" value="&lt;b&gt;Chat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;ChatNav · ChatThread · chat-store&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};size=48;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="111" y="184" width="269" height="1250" as="geometry" /></mxCell>
