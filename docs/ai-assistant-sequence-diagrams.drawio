        <mxCell id="seq6-19" value="Deleting the dashboard makes the draft “Not created yet” again. On every turn withStatus tells Claude which drafts were created, and as what." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#fdfdfd;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="298" y="1518" width="1131" height="26" as="geometry" /></mxCell>
        <mxCell id="seq6-20" value="“a dashboard for Riverside with …”" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="288" as="sourcePoint" /><mxPoint x="328" y="288" as="targetPoint" /></mxGeometry></mxCell>
