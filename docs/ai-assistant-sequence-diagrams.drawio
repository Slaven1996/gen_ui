        <mxCell id="seq8-50" value="DELETE (the user's own;&lt;br&gt;an unknown id is no error)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1179" y="1286" as="sourcePoint" /><mxPoint x="1425" y="1286" as="targetPoint" /></mxGeometry></mxCell>
