# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Set to true (or a hop count) when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ─── Database (also read by docker-compose via `pnpm db:up`) ───────────────
POSTGRES_USER=genui
POSTGRES_PASSWORD=genui
POSTGRES_DB=genui
POSTGRES_PORT=5434
DATABASE_URL=postgresql://genui:genui@localhost:5434/genui?schema=public

# ─── Access token (JWT, kept in memory on the client) ──────────────────────
# Generate with: openssl rand -base64 48   (min 32 chars)
JWT_ACCESS_SECRET=
# Lifetime in seconds
JWT_ACCESS_TTL=900
JWT_ISSUER=gen-ui-api
JWT_AUDIENCE=gen-ui-web

# ─── Refresh token (opaque, httpOnly cookie, rotated on every use) ─────────
REFRESH_TOKEN_TTL_DAYS=7
# A rotated token presented again within this window is treated as a benign
# multi-tab race (401, no revocation) instead of token theft.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
# Expired refresh tokens are deleted this many days after they expire (daily job)
REFRESH_TOKEN_PRUNE_AFTER_DAYS=30
REFRESH_COOKIE_NAME=refresh_token

# ─── Cookies & CORS ────────────────────────────────────────────────────────
# Must be true in production (HTTPS). Browsers may drop Secure cookies on http://localhost.
COOKIE_SECURE=false
# Leave empty for host-only cookies (recommended)
COOKIE_DOMAIN=
# Comma-separated list of allowed browser origins. Leave empty when the SPA is
# served from the same origin (the Vite dev proxy makes dev same-origin).
CORS_ORIGIN=

# ─── AI (Vercel AI SDK, Anthropic) ─────────────────────────────────────────
AI_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=64000
# Max model↔tool round-trips per chat request
AI_MAX_STEPS=5
# Optional: low | medium | high | xhigh | max  (empty = provider default)
AI_EFFORT=
# Stream the model's reasoning summary to the client
AI_SEND_REASONING=true
# Anthropic server-side refusal fallback (routes a refused request to a fallback model)
AI_REFUSAL_FALLBACK=true

# Required for the assistant; /api/ai/chat answers 503 until it is set
ANTHROPIC_API_KEY=

# ─── Telemetry ─────────────────────────────────────────────────────────────
# Writes plausible readings for every tag of an ONLINE device, through the same
# path a real gateway uses, so charts move and alarm rules fire in a demo.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=60
# Measurements older than this are deleted by a daily job (04:00)
TELEMETRY_RETENTION_DAYS=180

# ─── Seed ──────────────────────────────────────────────────────────────────
# `pnpm db:seed` runs every .sql file in backend/prisma/seed/ (see 001_users.sql
# for the demo accounts and their password). No env vars needed.
