{
  "name": "gen-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "pnpm --filter @gen-ui/shared build",
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @gen-ui/shared build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose rm -sfv postgres && docker volume rm gen-ui_pgdata && docker compose up -d --wait postgres",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "docker:up": "docker compose up --build -d",
    "docker:logs": "docker compose up --build",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d && docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v"
  }
}
