        <mxCell id="seq8-54" value="chat.stop():&lt;br&gt;aborts the fetch" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="273" y="1464" as="sourcePoint" /><mxPoint x="273" y="1480" as="targetPoint" /><Array as="points"><mxPoint x="303" y="1464" /><mxPoint x="303" y="1480" /></Array></mxGeometry></mxCell>
        <mxCell id="seq8-55" value="the connection closes" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="273" y="1518" as="sourcePoint" /><mxPoint x="518" y="1518" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="seq8-56" value="res “close” before the end&lt;br&gt;→ abort.abort()" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518" y="1544" as="sourcePoint" /><mxPoint x="518" y="1560" as="targetPoint" /><Array as="points"><mxPoint x="548" y="1544" /><mxPoint x="548" y="1560" /></Array></mxGeometry></mxCell>
        <mxCell id="seq8-57" value="abortSignal fires" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518" y="1598" as="sourcePoint" /><mxPoint x="754" y="1598" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="seq8-58" value="the model stream is cancelled&lt;br&gt;(no more tokens are spent)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="754" y="1644" as="sourcePoint" /><mxPoint x="997" y="1644" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="seq8-59" value="onEnd: withStoppedToolCalls&lt;br&gt;· withoutEmptyAnswer" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="754" y="1670" as="sourcePoint" /><mxPoint x="754" y="1686" as="targetPoint" /><Array as="points"><mxPoint x="784" y="1670" /><mxPoint x="784" y="1686" /></Array></mxGeometry></mxCell>
        <mxCell id="seq8-60" value="finish(id, user.id, messages)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="754" y="1724" as="sourcePoint" /><mxPoint x="1169" y="1724" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="seq8-61" value="SELECT … FOR UPDATE · UPDATE&lt;br&gt;(never re-creates a deleted chat)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1179" y="1770" as="sourcePoint" /><mxPoint x="1425" y="1770" as="targetPoint" /></mxGeometry></mxCell>
